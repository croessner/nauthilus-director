# Optional environment file for /etc/default/nauthilus-director.
# Use it only for non-secret values consumed by YAML ${NAME} placeholders.
# Secret bytes belong in the files named here, never in this environment file.

NAUTHILUS_DIRECTOR_CONTROL_TOKEN_FILE=/etc/nauthilus-director/control-token
NAUTHILUS_DIRECTOR_USERNAME_HASH_SALT_FILE=/etc/nauthilus-director/username-hash-salt
NAUTHILUS_DIRECTOR_REDIS_PASSWORD_FILE=/etc/nauthilus-director/redis-password
NAUTHILUS_DIRECTOR_REDIS_SENTINEL_PASSWORD_FILE=/etc/nauthilus-director/redis-sentinel-password
NAUTHILUS_DIRECTOR_NAUTHILUS_HTTP_PASSWORD_FILE=/etc/nauthilus-director/nauthilus-http-password
NAUTHILUS_DIRECTOR_NAUTHILUS_GRPC_PASSWORD_FILE=/etc/nauthilus-director/nauthilus-grpc-password
NAUTHILUS_DIRECTOR_NAUTHILUS_GRPC_TOKEN_FILE=/etc/nauthilus-director/nauthilus-grpc-token
